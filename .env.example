# Copie este arquivo para .env e ajuste os valores.
# O .env nunca deve ser versionado.

# dev | prod
GNZL_ENVIRONMENT=dev

# demo | shopee
# demo: dados ficticios, sem dependencia de rede (padrao)
# shopee: exige GNZL_SHOPEE_APP_ID e GNZL_SHOPEE_SECRET validos
GNZL_PROVIDER=demo

GNZL_HOST=127.0.0.1
GNZL_PORT=8000

# Limite de geracao concorrente de links por lote
GNZL_LINK_CONCURRENCY=3

# Timeout das chamadas HTTP a provedores externos, em segundos
GNZL_HTTP_TIMEOUT_SECONDS=15

# Caminho do banco. Se vazio, usa data/gnzl.db na raiz do projeto.
# GNZL_DATABASE_URL=

# Somente preencher quando a Open API de afiliados estiver liberada.
GNZL_SHOPEE_APP_ID=
GNZL_SHOPEE_SECRET=
# GNZL_SHOPEE_API_BASE=https://open-api.ffiliate.shopee.com.br/graphql
